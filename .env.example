# --- Supabase ---
# Project URL (https://<project-ref>.supabase.co), or http://127.0.0.1:54321 when running `supabase start`
SUPABASE_URL=
# Public, browser-safe key
SUPABASE_ANON_KEY=
# SERVER ONLY. Never ship to a browser bundle. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp Business Platform (Meta Cloud API) ---
# Numeric phone number ID from the Meta WhatsApp Manager (NOT the phone number itself)
META_WHATSAPP_PHONE_NUMBER_ID=
# Long-lived system user access token with whatsapp_business_messaging permission
META_WHATSAPP_ACCESS_TOKEN=
# Random string we generate; Meta sends it back during webhook GET handshake to prove ownership
META_WEBHOOK_VERIFY_TOKEN=
# Meta App Secret. Used to validate X-Hub-Signature-256 on incoming webhooks.
META_APP_SECRET=

# --- Bot service ---
# Public URL Meta will POST webhook events to (e.g. https://bot.negatic.dev/webhook)
BOT_PUBLIC_URL=
PORT=3001
